# Copy to .env.local for development, or set these in the box environment for prod.
# See CLAUDE.md "Database Rules" and "CI/CD" for how each of these is used.

# --- Database (self-hosted PostgreSQL, pgvector enabled) ---
DATABASE_URL=postgres://user:password@localhost:5432/surf_your_life

# --- Auth.js v5 ---
# AUTH_SECRET: random 32+ byte secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# AUTH_URL: canonical origin of the app (e.g. https://surf-your-life.orangecat.ch in prod)
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin promotion ---
# Comma-separated emails auto-promoted to the admin role on login. Leave unset to
# manage admin roles manually in the DB (see lib/auth/index.ts).
ADMIN_EMAILS=

# --- AI (chat, embeddings) ---
# ANTHROPIC_API_KEY: unset => ai-chat serves the rule-based response instead of
# Claude. Degraded, not broken, so this stays optional.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY: required in PRODUCTION. Without it no embedding can ever be
# generated, so /api/cron/embed-backfill fails closed with 503 rather than
# answering 200 forever against a permanently empty backlog (same rule as
# RESEND_API_KEY). Unset outside production is a no-op.
OPENAI_API_KEY=

# --- Transactional email (reminders, weekly report, ai-digest) ---
RESEND_API_KEY=
RESEND_FROM=

# --- Cron routes (app/api/cron/*) ---
# Bearer token the box scheduler (systemd timer / cron) must send to hit cron routes.
CRON_SECRET=

# --- Sentry error tracking (optional — no-ops when unset) ---
# set from sentry.io project settings to enable error tracking
NEXT_PUBLIC_SENTRY_DSN=
# optional, build-time only — enables sourcemap upload
SENTRY_AUTH_TOKEN=
